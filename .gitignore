# ============================================================
#  Что помним, а что нет.
#
#  Правило: мелочь помним, тяжёлое — нет. Порог примерно 2 МБ.
#
#  Но папки видно все, даже пустые. В каждой лежит записка
#  ЧТО_ЗДЕСЬ.txt — что сюда класть и где это взять. Записки
#  помним всегда, они и показывают структуру.
#
#  Всё, что не помним, никуда не девается — просто лежит
#  у тебя на диске, а история за этим не следит.
# ============================================================


# --- Личное. Лежит на диске, в историю не едет ---
#
# Репозиторий открытый: всё, что попадёт в историю, увидит кто угодно.
# Рабочие промпты сюда не кладём.
#
# В prompt.txt лежит нейтральный пример, чтобы сборка работала сразу
# после распаковки. Свой рабочий промпт держи в prompt_ЛИЧНЫЙ.txt и
# вставляй в prompt.txt, когда рисуешь.
/prompt_ЛИЧНЫЙ.txt
/Ivy.txt


# --- Мусор и то, что перерисовывается само ---
__pycache__/
*.pyc
_last_mask.png
/depth/map.png
/canny/map.png


# --- Твои картинки. Папки помним, картинки внутри — нет ---

/refs/*
!/refs/ЧТО_ЗДЕСЬ.txt

/depth/donor/*
!/depth/donor/ЧТО_ЗДЕСЬ.txt

/canny/donor/*
!/canny/donor/ЧТО_ЗДЕСЬ.txt

/logs/*
!/logs/ЧТО_ЗДЕСЬ.txt


# --- Обновлялка самого ComfyUI, приехала вместе с ним ---
/update/


# --- Портативный Git. Скачивается по требованию, весит много ---
/portable_git/*
!/portable_git/ЧТО_ЗДЕСЬ.txt


# --- Python, на котором всё крутится. 4.5 ГБ, не наш ---
/python_embeded/*
!/python_embeded/ЧТО_ЗДЕСЬ.txt


# ============================================================
#  ComfyUI — 16 ГБ чужого кода и моделей. Целиком не помним.
#
#  ВАЖНОЕ, ЧТОБЫ ПОТОМ НЕ ЛОМАТЬ ГОЛОВУ:
#  у самого ComfyUI внутри лежит свой такой же список,
#  ComfyUI\.gitignore, и в нём написано забыть /models/ и /user/.
#  Когда два списка спорят, побеждает тот, что лежит ближе
#  к файлу. Поэтому дописывать сюда исключения бесполезно —
#  они не сработают.
#
#  Зато файл, который один раз взяли в историю, остаётся в ней
#  навсегда, и никакие списки на него больше не действуют.
#  Так и сделано. Взято руками:
#
#     ComfyUI\user\__manager\config.ini          настройки, автостарт
#     ComfyUI\user\default\comfy.settings.json   настройки окна
#     ComfyUI\user\default\workflows\            твои схемы
#     ComfyUI\models\embeddings\NEGATIVE_HANDS   эмбеддинг, 24 КБ
#     ComfyUI\models\*\ЧТО_ЗДЕСЬ.txt             записки по папкам
#
#  Появилась новая схема или новая записка — её тоже надо взять
#  руками один раз:   git add -f <путь к файлу>
#
#  Только по одному файлу и без звёздочек! Звёздочка в гите лезет
#  и во вложенные папки тоже: "ComfyUI/*.txt" утащит словари
#  движка по 3.5 МБ из ComfyUI\comfy\text_encoders\.
# ============================================================

/ComfyUI/
