  },
  "50": {
    "class_type": "InpaintModelConditioning",
    "inputs": {
      "positive": ["5", 0],
      "negative": ["6", 0],
      "vae": ["4", 0],
      "pixels": ["60", 1],
      "mask": ["60", 2],
      "noise_mask": true
