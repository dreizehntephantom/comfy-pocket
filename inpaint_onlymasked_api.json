  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "seed": 0,
      "steps": 25,
      "cfg": 5,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "positive": ["50", 0],
      "negative": ["50", 1],
      "latent_image": ["50", 2],
      "denoise": 0.6
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["4", 0] }
  },
  "61": {
    "class_type": "InpaintStitchImproved",
    "inputs": { "stitcher": ["60", 0], "inpainted_image": ["11", 0] }
