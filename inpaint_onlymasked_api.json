    "inputs": { "image": "example.png" }
  },
  "70": {
    "class_type": "LoadImageMask",
    "inputs": { "image": "example_mask.png", "channel": "red" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["3", 0] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["3", 0] }
  },
  "60": {
