    "inputs": { "model": ["1", 0] }
  },
  "2": {
    "class_type": "LoraTagLoader",
    "inputs": {
      "model": ["40", 0],
      "clip": ["1", 1],
      "text": "<lora:sasaminanime:0.8>"
    }
  },
  "3": {
    "class_type": "CLIPSetLastLayer",
    "inputs": { "clip": ["2", 1], "stop_at_clip_layer": -2 }
