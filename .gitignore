# ============================================================
#  Что помним, а что нет.
#
#  Правило: мелочь помним, тяжёлое — нет. Порог примерно 2 МБ.
#
#  Но папки видно все, даже пустые. В каждой лежит записка
#  ЧТО_ЗДЕСЬ.txt — что сюда класть и где это взять. Записки
#  помним всегда, они и показывают структуру.
#
#  Всё, что не помним, никуда не девается — просто лежит
#  у тебя на диске, а история за этим не следит.
# ============================================================


# --- Мусор и то, что перерисовывается само ---
__pycache__/
*.pyc
_last_mask.png
/depth/map.png
/canny/map.png


# --- Твои картинки. Папки помним, картинки внутри — нет ---

/refs/*
!/refs/ЧТО_ЗДЕСЬ.txt

/depth/donor/*
!/depth/donor/ЧТО_ЗДЕСЬ.txt

/canny/donor/*
!/canny/donor/ЧТО_ЗДЕСЬ.txt

/logs/*
!/logs/ЧТО_ЗДЕСЬ.txt


# --- Обновлялка самого ComfyUI, приехала вместе с ним ---
/update/


# --- Портативный Git. Скачивается по требованию, весит много ---
/portable_git/*
!/portable_git/ЧТО_ЗДЕСЬ.txt


# --- Python, на котором всё крутится. 4.5 ГБ, не наш ---
/python_embeded/*
!/python_embeded/ЧТО_ЗДЕСЬ.txt


# ============================================================
#  ComfyUI — 16 ГБ чужого кода и моделей.
#  Помним оттуда только то, что наше: настройки, схемы,
#  маленький эмбеддинг и записки.
#
#  Гит не умеет возвращать файл из выброшенной папки, поэтому
#  ниже каждый уровень открывается отдельно. Выглядит нудно,
#  но иначе не работает.
# ============================================================

/ComfyUI/*
!/ComfyUI/ЧТО_ЗДЕСЬ.txt

# --- твои настройки и сохранённые схемы ---
!/ComfyUI/user/
/ComfyUI/user/*

!/ComfyUI/user/__manager/
/ComfyUI/user/__manager/*
!/ComfyUI/user/__manager/config.ini

!/ComfyUI/user/default/
/ComfyUI/user/default/*
!/ComfyUI/user/default/comfy.settings.json
!/ComfyUI/user/default/workflows/

# --- модели: тяжёлые, помним только записки, где их скачать ---
!/ComfyUI/models/
/ComfyUI/models/*
!/ComfyUI/models/*/
/ComfyUI/models/*/*
!/ComfyUI/models/*/ЧТО_ЗДЕСЬ.txt

# кроме этого — 24 КБ, помним целиком
!/ComfyUI/models/embeddings/NEGATIVE_HANDS.safetensors
